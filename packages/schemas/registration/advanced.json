{
	"entity": "registration",
	"type": "advanced",
	"form": {
		"type": "object",
		"required": ["key","email"],
		"properties": {
			"key": {
				"type": "string", 
				"title": "License Key", 
				"placeholder": "XXXXX-XXXXX-XXXXX-XXXXX-XXXXX",
				"pattern": "^[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}$"
			},
			"email": {
				"type": "string", 
				"title": "Email", 
				"format": "email"
			}
		}
	},
	"onSuccess": {
		"redirect": "./success"
	},
	"plugin": "JUCE"
}